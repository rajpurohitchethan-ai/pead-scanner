eting", "CRITICALNEWS": "0", "DT_TM": "2026-11-05T15:46:06.083", "DissemDT": "2026-11-05T15:46:06.083", "FILESTATUS": "N    ", "Fld_Attachsize": 3394656, "HEADLINE": "Pursuant to Regulation 30(2) of SEBI (Listing Obligations and Disclosure Requirements) Regulations, 2015 and our prior intimation dated 28th October, 2026, we wish to inform you that the ....", "Investor_Presentation": null, "MORE": "Pursuant to Regulation 30(2) of SEBI (Listing Obligations and Disclosure Requirements) Regulations, 2015 and our prior intimation dated 28th October, 2026, we wish to inform you that the Board of Directors of the Company at their meeting held today i.e., Thursday, 05th November 2026 which commenced at 02:00 P.M. (IST) and concluded at 03:30 P.M. (IST), have inter alia, approved and taken on record the following:\r\n 1. Unaudited Financial Results of the Company for the quarter and half year ended 30th September, 2026.\r\n 2. Limited Review Report of the Statutory Auditors of the Company for the quarter and half year ended 30th September, 2026.\r\n", "NEWSID": "1a62cc41-33b3-4208-87ba-a1a2b4c1f5ca", "NEWSSUB": "Board Meeting Outcome for Outcome Of The Board Meeting Held On 5Th November 2026 Under Regulation 30(2) Of SEBI (Listing Obligations And Disclosure Requirements) Regulations, 2015\r\n\r\n", "NEWS_DT": "2026-11-05T15:46:06.083", "NSURL": "https://www.bseindia.com/stock-share-price/kiduja-india-ltd/kiduja/507946/", "News_submission_dt": "2026-11-05T15:46:03", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 507946, "SLONGNAME": "Kiduja India Ltd", "SUBCATNAME": "Outcome of Board Meeting", "TimeDiff": "00:00:03", "XML_NAME": "ANN_507946_1A62CC41-33B3-4208-87BA-A1A2B4C1F5CA"}, {"AGENDA_ID": 9, "ANNOUNCEMENT_TYPE": "A", "ATTACHMENTNAME": "ab53b65d-5b6d-4c00-a0b9-29db009305e1.pdf", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "1", "DT_TM": "2026-10-28T12:36:46.52", "DissemDT": "2026-10-28T12:36:46.52", "FILESTATUS": "N    ", "Fld_Attachsize": 240616, "HEADLINE": "Kiduja India Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 05/11/2026 ,inter alia, to consider and approve This is to inform you that the ....", "Investor_Presentation": null, "MORE": "Kiduja India Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 05/11/2026 ,inter alia, to consider and approve This is to inform you that the Meeting of the Board of Directors of Kiduja India Limited will be held on Thursday, 5th November, 2026, at 02:00 p.m. at the Registered Office of the Company to consider and approve the Unaudited Financial Results of the Company for the Quarter and Half Year ended 30th September 2026.\r\n\r\n\r\n", "NEWSID": "d5ce04ae-2c45-4ef5-a190-63ab606b33a9", "NEWSSUB": "Board Meeting Intimation for Notice Of Board Meeting.", "NEWS_DT": "2026-10-28T12:36:46.52", "NSURL": "https://www.bseindia.com/stock-share-price/kiduja-india-ltd/kiduja/507946/", "News_submission_dt": "2026-10-28T12:36:45", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 507946, "SLONGNAME": "Kiduja India Ltd", "SUBCATNAME": "Board Meeting", "TimeDiff": "00:00:01", "XML_NAME": "ANN_507946_D5CE04AE-2C45-4EF5-A190-63AB606B33A9"}]