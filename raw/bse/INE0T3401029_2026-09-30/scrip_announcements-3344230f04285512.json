A_ID": 198, "ANNOUNCEMENT_TYPE": "A", "ATTACHMENTNAME": "96159e30-82f2-4203-8da0-10296c1ecf75.pdf", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "0", "DT_TM": "2026-11-02T17:33:55.837", "DissemDT": "2026-11-02T17:33:55.837", "FILESTATUS": "N    ", "Fld_Attachsize": 4511907, "HEADLINE": "We hereby inform the Stock Exchange that the Board of Directors of the Company in their Meeting No. 4/2026-27 held on Monday, 02nd November, 2026, inter alia other businesses, has transacted ....", "Investor_Presentation": null, "MORE": "We hereby inform the Stock Exchange that the Board of Directors of the Company in their Meeting No. 4/2026-27 held on Monday, 02nd November, 2026, inter alia other businesses, has transacted the following main business:\r\n1. Considered and approved the standalone and consolidated unaudited financial results of the Company for the half year ended 30th September, 2026, along with the Limited Review Reports thereon issued by the Statutory Auditor.\r\n2. To considered and approved the appointment of Mr. Bhupeshkumar Vrajnathdas Parikh (DIN - 11956163) as an additional director (non-executive, independent) on the board of the company, subject to applicable approvals, if any.\r\n3. To considered, approved and took note the Resignation of Mr. Chandresh Madhubhai Unagar (DIN -10482172) from the position of Non-Executive Independent Director of the Company;\r\n4.     To Considered and approved Business Expansion and Capex; \r\n", "NEWSID": "8521e106-f756-41d3-8cfc-8799c0a2aebe", "NEWSSUB": "Board Meeting Outcome for Outcome Of Board Meeting Held Today, 02Nd November, 2026", "NEWS_DT": "2026-11-02T17:33:55.837", "NSURL": "https://www.bseindia.com/stock-share-price/aelea-commodities-ltd/acld/544213/", "News_submission_dt": "2026-11-02T17:33:52", "OLD": 1, "PDFFLAG": 0, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 544213, "SLONGNAME": "Aelea Commodities Ltd", "SUBCATNAME": "Outcome of Board Meeting", "TimeDiff": "00: