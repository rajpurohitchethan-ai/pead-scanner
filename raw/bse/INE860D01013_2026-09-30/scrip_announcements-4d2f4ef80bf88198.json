df", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "0", "DT_TM": "2026-11-05T14:17:04.087", "DissemDT": "2026-11-05T14:17:04.087", "FILESTATUS": "N    ", "Fld_Attachsize": 4505822, "HEADLINE": "Dear Sir/Madam,\r\n\r\nIn terms of Regulation 30 read with part A of Schedule III of the SEBI (Listing Obligations & Disclosure Requirements) Regulations, 2015 (\"the Listing Regulations\"), ....", "Investor_Presentation": null, "MORE": "Dear Sir/Madam,\r\n\r\nIn terms of Regulation 30 read with part A of Schedule III of the SEBI (Listing Obligations & Disclosure Requirements) Regulations, 2015 (\"the Listing Regulations\"), we wish to inform you that, in their meeting held today i.e. 05th November, 2026 has inter-alia considered and approved the following:\r\n\r\n1. Unaudited Financial Results along with Limited Review Report as submitted by the statutory auditor of the Company for the Second Quarter and Half Year Ended 30th September, 2026. \r\n\r\nAccordingly, the Unaudited Financial Results for Second Quarter and Half Year Ended 30th September, 2026 along with Limited Review Report are attached herewith as 'Annexure I'.\r\n", "NEWSID": "1cb0a76f-d7fb-4fed-ae13-8abaa32cad05", "NEWSSUB": "Board Meeting Outcome for Outcome Of Board Meeting Held On Thursday, 05Th November, 2026", "NEWS_DT": "2026-11-05T14:17:04.087", "NSURL": "https://www.bseindia.com/stock-share-price/sanjivani-paranteral-ltd/sanjivin/531569/", "News_submission_dt": "2026-11-05T14:17:01", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 531569, "SLONGNAME": "Sanjivani Paranteral Ltd", "SUBCATNAME": "Outcome of Board Meeting", "TimeDiff": "00:00:03", "XML_NAME": "ANN_531569_1CB0A76F-D7FB-4FED-AE13-8ABAA32CAD05"}, {"AGENDA_ID": 9, "ANNOUNCEMENT_TYPE": "A", "ATTACHMENTNAME": "6621401d-9223-48ba-9446-386ac9d4e61c.pdf", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "1", "DT_TM": "2026-10-29T20:35:29.173", "DissemDT": "2026-10-29T20:35:29.173", "FILESTATUS": "N    ", "Fld_Attachsize": 338692, "HEADLINE": "Sanjivani Paranteral Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 05/11/2026 ,inter alia, to consider and approve \r\n1. To approve the Un-Audited ....", "Investor_Presentation": null, "MORE": "Sanjivani Paranteral Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 05/11/2026 ,inter alia, to consider and approve \r\n1. To approve the Un-Audited Financials along with Limited Review Report for the Second Quarter ended 30th September, 2026 pursuant to Regulation 33 of the Listing Obligation and Disclosure Requirement, 2015.\r\n             \r\n2. Any other matter with the permission of Chair and with the consent of a majority of the Directors present in the Meeting including at least one Independent Director.\r\n", "NEWSID": "ad5a2b0d-601f-481c-93e1-ab3504b9a29e", "NEWSSUB": "Board Meeting Intimation for Intimation Of Notice Of Board Meeting To Be Held On Thursday, 05Th November, 2026 Pursuant To Regulation 29 Of SEBI (Listing Obligations And Disclosure Requirements) Regulations, 2015.", "NEWS_DT": "2026-10-29T20:35:29.173", "NSURL": "https://www.bseindia.com/stock-share-price/sanjivani-paranteral-ltd/sanjivin/531569/", "News_submission_dt": "2026-10-29T20:35:27", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 531569, "SLONGNAME": "Sanjivani Paranteral Ltd", "SUBCATNAME": "Board Meeting", "TimeDiff": "00:00:02", "XML_NAME": "ANN_531569_AD5A2B0D-601F-481C-93E1-AB3504B9A29E"}]