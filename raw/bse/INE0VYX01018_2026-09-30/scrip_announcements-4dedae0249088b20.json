TYPE": "A", "ATTACHMENTNAME": "aee1c128-4ed7-4e42-bf90-f58c2f4bd657.pdf", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "1", "DT_TM": "2026-10-24T12:24:03.537", "DissemDT": "2026-10-24T12:24:03.537", "FILESTATUS": "N    ", "Fld_Attachsize": 256810, "HEADLINE": "Nukleus Office Solutions Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 31/10/2026 ,inter alia, to consider and approve We hereby inform you ....", "Investor_Presentation": null, "MORE": "Nukleus Office Solutions Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 31/10/2026 ,inter alia, to consider and approve We hereby inform you that a meeting of the Board of Directors of the Company will be held on Saturday, October 31, 2026, inter alia, to consider and approve the following:\r\n1. The Un-audited Financial Results (subject to Limited Review) of the Company for the half year ended September 30, 2026;\r\n2. Alteration of the Memorandum of Association (MOA) of the Company in respect of the Objects Clause (Clause III);\r\n3. Increase in the Authorised Share Capital of the Company and consequential alteration of the Capital Clause (Clause V) of the MOA;\r\n4. The Postal Ballot Notice for seeking the approval of the Members on the matters at items 2 and 3 above, appointment of the Scrutinizer(s) and fixing of the cut-off date; and\r\n5. Any other matter with the permission of the Chair.", "NEWSID": "614a78b3-6407-4f2a-8c4f-808d8da97b9a", "NEWSSUB": "Board Meeting Intimation for As Mentioned In The Body And Enclosure Of This Intimation.", "NEWS_DT": "2026-10-24T12:24:03.537", "NSURL": "https://www.bseindia.com/stock-share-price/nukleus-office-solutions-ltd/nukleus/544370/", "News_submission_dt": "2026-10-24T12:24:02", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 544370, "SLONGNAME": "Nukleus Office Solutions Ltd", "SUBCATNAME": "Board Meeting", "TimeDiff": "00:00:01", "XML_NAME": "ANN_544370_614A78B3-6407-4F2A-8C4F-808D8DA97B9A"}]