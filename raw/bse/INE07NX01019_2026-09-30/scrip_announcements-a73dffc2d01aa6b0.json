ull, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "0", "DT_TM": "2026-11-14T19:37:09.803", "DissemDT": "2026-11-14T19:37:09.803", "FILESTATUS": "N    ", "Fld_Attachsize": 7423765, "HEADLINE": "Outcome of Board Meeting held on 14th November 2026 attached.", "Investor_Presentation": null, "MORE": "", "NEWSID": "515f2118-f0ff-4fee-8e9e-101e3f87d2ba", "NEWSSUB": "Board Meeting Outcome for Outcome For Held On 14Th November 2026", "NEWS_DT": "2026-11-14T19:37:09.803", "NSURL": "https://www.bseindia.com/stock-share-price/punctual-trading-ltd/punctrd/512461/", "News_submission_dt": "2026-11-14T19:37:07", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 512461, "SLONGNAME": "Punctual Trading Ltd", "SUBCATNAME": "Outcome of Board Meeting", "TimeDiff": "00:00:02", "XML_NAME": "ANN_512461_515F2118-F0FF-4FEE-8E9E-101E3F87D2BA"}, {"AGENDA_ID": 9, "ANNOUNCEMENT_TYPE": "A", "ATTACHMENTNAME": "78aba1c1-bd59-4e4a-94a2-5ca726a72eaa.pdf", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "1", "DT_TM": "2026-11-07T16:10:36.18", "DissemDT": "2026-11-07T16:10:36.18", "FILESTATUS": "N    ", "Fld_Attachsize": 415958, "HEADLINE": "Punctual Trading Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 14/11/2026 ,inter alia, to consider and approve This is to inform you that ....", "Investor_Presentation": null, "MORE": "Punctual Trading Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 14/11/2026 ,inter alia, to consider and approve This is to inform you that pursuant to Regulation 29 and other applicable provisions of the SEBI (Listing Obligations and Disclosure Requirements) Regulations, 2015, a meeting of the Board of Directors of the Company is scheduled to be held on Saturday, 14th November 2026, inter alia, to consider and transact the following matters:\r\n\r\n1. To consider and approve the Un-audited Financial Results of the Company for the quarter and half year ended 30th September 2026.\r\n2. To consider and approve the appointment of a Statutory Auditor of the Company\r\n3. To consider and approve the change of Registrar and Share Transfer Agent (RTA) of the Company and other related matters.\r\n4. To consider and approve the Notice of the Extra-Ordinary General Meeting (EGM) of the Company, along with other related matters.\r\n5. To consider and transact any other matter with the permission of the Chair and as may be approved by the Board of Directors.\r\n", "NEWSID": "ebe08e04-490b-4405-a4ad-5ad90a436e0f", "NEWSSUB": "Board Meeting Intimation for Consider And Approve The Un-Audited Financial Results Of The Company For The Quarter And Half Year Ended 30Th September 2026 And Other Matter As Specified.", "NEWS_DT": "2026-11-07T16:10:36.18", "NSURL": "https://www.bseindia.com/stock-share-price/punctual-trading-ltd/punctrd/512461/", "News_submission_dt": "2026-11-07T16:10:35", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 512461, "SLONGNAME": "Punctual Trading Ltd", "SUBCATNAME": "Board Meeting", "TimeDiff": "00:00:01", "XML_NAME": "ANN_512461_EBE08E04-490B-4405-A4AD-5AD90A436E0F"}]