, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 543622, "SLONGNAME": "Steelman Telecom Ltd", "SUBCATNAME": "Outcome of Board Meeting", "TimeDiff": "00:00:03", "XML_NAME": "ANN_543622_9FC3272E-C44D-41A5-AAD1-C932DCF244A4"}, {"AGENDA_ID": 9, "ANNOUNCEMENT_TYPE": "A", "ATTACHMENTNAME": "622185f3-b04e-40c2-99dc-907c4b855fb3.pdf", "AUDIO_VIDEO_FILE": null, "BSENewsid": null, "CATEGORYNAME": "Board Meeting", "CRITICALNEWS": "1", "DT_TM": "2026-11-06T12:34:19.62", "DissemDT": "2026-11-06T12:34:19.62", "FILESTATUS": "N    ", "Fld_Attachsize": 693286, "HEADLINE": "Steelman Telecom Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 14/11/2026 ,inter alia, to consider and approve Notice is hereby given that ....", "Investor_Presentation": null, "MORE": "Steelman Telecom Ltdhas informed BSE that the meeting of the Board of Directors of the Company is scheduled on 14/11/2026 ,inter alia, to consider and approve Notice is hereby given that pursuant to Regulation 29(1)(a) and other applicable Regulation of the SEBI (Listing Obligations and Disclosure Requirements) Regulations, 2015, a meeting of the Board of Directors of M/S Steelman Telecom Limited will be held on Saturday, 14th November, 2026 at MANI CASADONA, FLAT NO 15E1, FLOOR NO-15, PLOT NO-IIF/04, STREETNO-372, ACTION AREAIIF, NEW TOWN, KOLKATA-700156, inter-alia, to consider and approve the Un-Audited Standalone and Consolidated Financial Results of the Company for the Half Yearly ended 30th September, 2026.\r\nAs informed earlier vide our letter dated 25.09.2026, the Trading Window for dealing the securities of the Company would remain closed for the purpose of Un-Audited Financial Results for the half yearly ended 30th September 2026, along with other matters with effect from October 01, 2026 till 48 hours after the declaration of Un-Audited Financial Results of the Company. \r\n", "NEWSID": "36b40911-3492-42ca-8e21-22a440116f47", "NEWSSUB": "Board Meeting Intimation for Intimation Of Board Meeting To Consider And Approve The Unaudited Financial Results For The Half Year Ended 30Th September, 2026", "NEWS_DT": "2026-11-06T12:34:19.62", "NSURL": "https://www.bseindia.com/stock-share-price/steelman-telecom-ltd/stml/543622/", "News_submission_dt": "2026-11-06T12:34:18", "OLD": 1, "PDFFLAG": 1, "QUARTER_ID": null, "RN": 1, "SCRIP_CD": 543622, "SLONGNAME": "Steelman Telecom Ltd", "SUBCATNAME": "Board Meeting", "TimeDiff": "00:00:01", "XML_NAME": "ANN_543622_36B40911-3492-42CA-8E21-22A440116F47"}]