rescribed under the approved Resolution Plan.   7. As provided in resolution plan, approved by Hon'ble NCLT vide its order dated 12th May 2023, Board has cancelled 100% shareholding of erstwhile promoters i.e. 3,77,97,226 of Rs.10/- each in it's Board Meeting held on 27.12.2023. Further, the Board had approved the allotment of 98,74,932 equity shares of Rs.10/- each to Manjeet Cotton Private Limited.      8.In terms of the relevant clauses of the approved Resolution Plan, the Company has sold the Buttibori unit during the period under consideration.      9.There is one shareholder investors complaint received and disposed as well during period under review.", "re_desc_note_seg": "-", "re_dil_eps_bfr_exi": null, "re_dilut_eps_for_cont_dic_opr": "-0.82", "re_diluted_eps": null, "re_excepn_items": null, "re_excepn_items_new": "0", "re_extraord_items": null, "re_face_val": "10", "re_face_value_debt": null, "re_from_dt": "01-OCT-2023", "re_goi_per_shhd": null, "re_grs_npa": null, "re_grs_npa_per": null, "re_inc_dre_sttr": "0", "re_income_inv": null, "re_int_dis_adv_bills": null, "re_int_earned": null, "re_int_expd": null, "re_int_new": "0", "re_int_ser_cov": null, "re_minority_int": null, "re_net_profit": "-302.35", "re_net_sale": "0", "re_notes_to_ac": "", "re_oper_exp": null, "re_oper_exp_bef_pro_cont": null, "re_oth": null, "re_oth_exp": "42.57", "re_oth_inc": null, "re_oth_inc_new": "5.22", "re_oth_oper_exp": null, "re_oth_pro_cont": null, "re_oth_tot_exp": "307.57", "re_paid_debt": null, "re_pdup": "6184.97", "re_per_grs_npa": null, "re_pro_aft_int_bef_excep": null, "re_pro_los_frm_dis_opr": "0", "re_pro_loss_bef_tax": "-302.35", "re_pro_loss_bef_tax_sum": null, "re_prolos_dis_opr_aftr_tax": "0", "re_proloss_ord_act": "-302.35", "re_prov_emp_pay": null, "re_pur_trd_goods": "0", "re_rawmat_consump": "0", "re_remarks": null, "re_res_reval": null, "re_res_type": "U", "re_ret_asset": null, "re_seg_remarks": null, "re_seq_num": "1181219", "re_share_associate": "0", "re_s