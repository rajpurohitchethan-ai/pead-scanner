, Dhanuka plans to expand its footprint in more than 20 countries, including the regions of LATAM, EMEA and Asia including India.      7. The Results can also be viewed at our website www.dhanuka.com and on the website of BSE & NSE where the Company's shares are listed i.e. at www.bseindia.com and www.nseindia.com respectively. Any query from investors can be sent on email at investors@dhanuka.com.", "re_desc_note_seg": "-", "re_dil_eps_bfr_exi": null, "re_dilut_eps_for_cont_dic_opr": "12.25", "re_diluted_eps": null, "re_excepn_items": null, "re_excepn_items_new": "0", "re_extraord_items": null, "re_face_val": "2", "re_face_value_debt": null, "re_from_dt": "01-OCT-2024", "re_goi_per_shhd": null, "re_grs_npa": null, "re_grs_npa_per": null, "re_inc_dre_sttr": "6539.52", "re_income_inv": null, "re_int_dis_adv_bills": null, "re_int_earned": null, "re_int_expd": null, "re_int_new": "143.43", "re_int_ser_cov": "0", "re_minority_int": null, "re_net_profit": "5504.47", "re_net_sale": "44527.21", "re_notes_to_ac": "", "re_oper_exp": null, "re_oper_exp_bef_pro_cont": null, "re_oth": null, "re_oth_exp": "5998.09", "re_oth_inc": null, "re_oth_inc_new": "701.32", "re_oth_oper_exp": null, "re_oth_pro_cont": null, "re_oth_tot_exp": "38420.86", "re_paid_debt": null, "re_pdup": "901.57", "re_per_grs_npa": null, "re_pro_aft_int_bef_excep": null, "re_pro_los_frm_dis_opr": "0", "re_pro_loss_bef_tax": "6807.67", "re_pro_loss_bef_tax_sum": null, "re_prolos_dis_opr_aftr_tax": "0", "re_proloss_ord_act": "5504.47", "re_prov_emp_pay": null, "re_pur_trd_goods": "3128.39", "re_rawmat_consump": "17071.67", "re_remarks": null, "re_res_reval": null, "re_res_type": "U", "re_ret_asset": null, "re_seg_remarks": null, "re_seq_num": "1192241", "re_share_associate": "0", "re_staff_cost": "4233.8", "re_tax": "1303.2", "re_tax_expens_of_dis_opr": "0", "re_to_dt": "31-DEC-2024", "re_tot_exp_exc_pro_cont": null, "re_tot_inc": null, "re_total_inc": "45228.53"}, {"re_amt_grs_np_asst": null, "re_bal_rbi_oth_b