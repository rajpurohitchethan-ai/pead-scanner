[{"an_dt": "13-Nov-2026 18:00:24", "attFileSize": "1.14 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/TEMPSENS_13112026180012_F_Transcript.pdf", "attchmntText": "Tempsens Instruments (India) Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "13112026180024", "exchdisstime": "13-Nov-2026 18:00:25", "fileSize": "1.14 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106859303", "smIndustry": null, "sm_isin": "INE1KZI01025", "sm_name": "Tempsens Instruments (India) Limited", "sort_date": "2026-11-13 18:00:24", "symbol": "TEMPSENS", "voiceSummary": "Tempsens Instruments filed the transcript of its Q2 FY27 earnings conference call held on October 31, 2026. Consolidated revenue for the half year ended September 30, 2026, grew 33.7% to INR255 crores. EBITDA increased 12% to INR55 crores, and adjusted profit after tax rose 17% to INR38 crores. Export revenue more than doubled to INR94 crores, representing 37% of product revenue. The company added Tempsens Germany, Tempsens Polska, and Tempsens Measurement and Control to its consolidation. Borrowings decreased to INR41 crores from INR77.9 crores in March 2026, following INR55 crores of IPO proceeds used for debt repayment. Five capacity expansion projects are underway with a combined peak revenue potential of INR500 crores. New product supplies, including high-temperature wiring harnesses and laboratory furnaces, are scheduled to begin in the second half of the year.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/TEMPSENS_13112026180012_F_Transcript.mp3"}, {"an_dt": "06-Nov-2026 12:31:48", "attFileSize": "5.18 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/TEMPSENS_06112026123139_F_Newspaper_Intimation.pdf", "attchmntText": "Tempsens Instruments (India) Limited has informed the Exchange about Copy of Newspaper Publication", "bflag": nu