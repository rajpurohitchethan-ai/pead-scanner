[{"an_dt": "12-Nov-2026 18:04:51", "attFileSize": "0 Bytes", "attchmntFile": "-", "attchmntText": "Significant increase in volume has been observed in Amanta Healthcare Limited. The Exchange, in order to ensure that investors have latest relevant information about the company and to inform the market place so that the interest of the investors is safeguarded, has written to the company. The response from the company is awaited.", "bflag": null, "csvName": null, "desc": "Spurt in Volume", "difference": "00:00:01", "dt": "12112026180451", "exchdisstime": "12-Nov-2026 18:04:52", "fileSize": "0 Bytes", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106857138", "smIndustry": null, "sm_isin": "INE084K01015", "sm_name": "Amanta Healthcare Limited", "sort_date": "2026-11-12 18:04:51", "symbol": "AMANTA", "voiceSummary": null, "voiceUrl": null}, {"an_dt": "09-Nov-2026 14:38:21", "attFileSize": "928.08 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/AMANTA_09112026143736_Intimation_of_Transcript.pdf", "attchmntText": "Amanta Healthcare Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "09112026143821", "exchdisstime": "09-Nov-2026 14:38:22", "fileSize": "928.08 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106853353", "smIndustry": null, "sm_isin": "INE084K01015", "sm_name": "Amanta Healthcare Limited", "sort_date": "2026-11-09 14:38:21", "symbol": "AMANTA", "voiceSummary": "Amanta Healthcare Limited filed a notice regarding the transcript of its Q2 and H1 FY27 earnings conference call held on November 4, 2026. The company reported Q2 revenue of INR83.1 crore, a 17% year-on-year increase, with EBITDA rising 22% to INR18 crore. Half-year revenue stood at INR151.9 crore, up 12%, while half-year PAT increased 12% to INR8.17 crore. Management highlighted the operational launch of SteriPort Line 3, boosting capacity by 75% to INR11.6 crore annually. A 10.8 megawatt captive solar plant is generating power, expected to save INR9 crore annually. The debt-to-equity ratio improved to 1.1. Expansion of small volume parenterals capacity by 52% is scheduled for Q1 FY28. The company aims for 20% plus CAGR revenue growth and 25% plus EBITDA margins over two years. Total borrowing was INR190 crore as of September end.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/AMANTA_09112026143736_Intimation_of_Transcript.mp3"}, {"an_dt": "07-Nov-2026 14:43:49", "attFileSize": "1.14 MB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/AMANTA_07112026144340_Intimation_Under_SEBI_PIT_Regulations.pdf", "attchmntText": "Amanta Healthcare Limited has informed the Exchange regarding 'Disclosure under Regulation 7(2) of the SEBI (Prohibition of InsiderTrading) Regulations, 2015 (the  Insider Trading Regulations )'.", "bflag": null, "csvName": null, "desc": "Updates", "difference": "00:00:01", "dt": "07112026144349", "exchdisstime": "07-Nov-2026 14:43:50", "fileSize": "1.14 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106852370", "smIndustry": null, "sm_isin": "INE084K01015", "sm_name": "Amanta Healthcare Limited", "sort_date": "2026-11-07 14:43:49", "symbol": "AMANTA", "voiceSummary": "Amanta Healthcare Limited has submitted a disclosure under Regulation 7(2) of the SEBI Prohibition of Insider Trading Regulations 2015 regarding an off-market transaction of equity shares. The company received a declaration in Form C from Shri Jitendrakumar Jashbhai Patel, who is identified as a promoter of the company. This filing was addressed to the listing departments of BSE Limited and the National Stock Exchange of India Limited on November 7, 2026. The submission includes the enclosed disclosures received from the promoter. The company requests the exchanges to take the documents on record and acknowledge receipt. The filing was signed by Nikhita Dinodia, the Company Secretary and Compliance Officer.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/AMANTA_07112026144340_Intimation_Under_SEBI_PIT_Regulations.mp3"}, {"an_dt": "05-Nov-2026 14:35:11", "attFileSize": "4.13 MB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/AMANTA_05112026143503_Intimation_Newspaper_Publication_Q2.pdf", "attchmntText": "Amanta Healthcare Limited has informed the Exchange about Copy of Newspaper Publication", "bflag": null, "csvName": null, "desc": "Copy of Newspaper Publication", "difference": "00:00:01", "dt": "05112026143511", "exchdisstime": "05-Nov-2026 14:35:12", "fileSize": "4.13 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106846995", "smIndustry": null, "sm_isin": "INE084K01015", "sm_name": "Amanta Healthcare Limited", "sort_date": "2026-11-05 14:35:11", "symbol": "AMANTA", "voiceSummary": null, "voiceUrl": null}, {"an_dt": "04-Nov-2026 17:58:03", "attFileSize": "480.49 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/AMANTA_04112026175752_Audio_Recording_Q2.pdf", "attchmntText": "Amanta Healthcare Limited has informed the Exchange about Link of Recording", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "04112026175803", "exchdisstime": "04-Nov-2026 17:58:04", "fileSize": "480.49 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106845036", "smIndustry": null, "sm_isin": "INE084K01015", "sm_name": "Amanta Healthcare Limited", "sort_date": "2026-11-04 17:58:03", "symbol": "AMANTA", "voiceSummary": null, "voiceUrl": null}, {"an_dt": "04-Nov-2026 13:56:26", "attFileSize": "794.07 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/AMANTA_04112026135616_Intimation_Monitoring_Agency_Report.pdf", "attchmntText": "submission of Monitoring Agency Report for the quarter ended September 30, 2026", "bflag": null, "csvName": null, "desc": "Monitoring Agency Report", "difference": "00: