[{"an_dt": "23-Nov-2026 14:56:01", "attFilePath": null, "attFileSize": "307.20 KB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/COALINDIA_23112026145349_CISM230926.pdf", "attchmntText": "Disclosure under Regulation 30 of SEBI (Listing Obligations and Disclosure Requirements), Regulations 2015-Change in Senior Management", "bflag": null, "csvName": null, "desc": "Appointment", "difference": "00:00:01", "dt": "23112026145601", "exchdisstime": "23-Nov-2026 14:56:02", "fileSize": "307.20 KB", "hasXbrl": true, "nasUploadFlag": null, "objUploadFlag": null, "old_new": null, "orgid": null, "seq_id": "106868814", "smIndustry": "Mining", "sm_isin": "INE522F01014", "sm_name": "Coal India Limited", "sort_date": "2026-11-23 14:56:01", "symbol": "COALINDIA", "voiceSummary": "Coal India Limited disclosed a change in senior management personnel pursuant to Regulation 30 of SEBI Listing Obligations and Disclosure Requirements Regulations 2015. The company notified that certain officials have been promoted to the position of Senior Management Personnel, specifically Executive Directors one level below the Board. The announcement identifies Shri Deepak Saxena as Executive Director Coordination and Shri Binay Kumar Jha as Executive Director Contracts. The disclosure was issued by B. P Dubey, Executive Director Corporate Secretary and Compliance Officer. The notice was addressed to the Listing Departments of the Bombay Stock Exchange and the National Stock Exchange of India Limited. The filing references SEBI Circular dated January 30, 2026. The document includes brief professional profiles for the promoted executives, detailing their educational backgrounds and tenure with Coal India Limited.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/COALINDIA_23112026145349_CISM230926.mp3"}, {"an_dt": "21-Nov-2026 12:49:13", "attFilePath": null, "attFileSize": "308.54 KB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/COALINDIA_21112026124901_CISM.pdf", "attc