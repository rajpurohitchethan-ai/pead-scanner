[{"an_dt": "10-Nov-2026 16:33:42", "attFileSize": "528.40 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/INDSWFTLAB_10112026163304_Intimation.pdf", "attchmntText": "Ind-Swift Laboratories Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "10112026163342", "exchdisstime": "10-Nov-2026 16:33:43", "fileSize": "528.40 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106854246", "smIndustry": "Pharmaceuticals", "sm_isin": "INE915B01019", "sm_name": "Ind-Swift Laboratories Limited", "sort_date": "2026-11-10 16:33:42", "symbol": "INDSWFTLAB", "voiceSummary": "Ind-Swift Laboratories Ltd. filed the transcript of its Q2 FY27 earnings conference call with BSE and NSE on November 10, 2026. The call discussed un-audited financial results for the quarter ended September 30, 2026. Operating revenue for Q2 stood at Rs. 234.89 crore, up 50.15% year-on-year. Operating EBITDA rose to Rs. 42.33 crore, with a margin of 18.02%. Profit after tax was Rs. 31.03 crore. For the half-year, operating revenue reached Rs. 420.97 crore, and PAT was Rs. 55.47 crore. The company reiterated guidance for more than 50% revenue growth in FY27. It aims to cross Rs. 1,500 crore by FY30. The firm remains net debt-free. Commercial partnerships are expected to deliver Rs. 100 to Rs. 130 crore in incremental revenue in FY27. The Samba facility upgrade to EU-GMP standards is on schedule.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/INDSWFTLAB_10112026163304_Intimation.mp3"}, {"an_dt": "04-Nov-2026 19:35:44", "attFileSize": "294.43 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/INDSWFTLAB_04112026193343_INTIMATION.pdf", "attchmntText": "Ind-Swift Laboratories Limited has informed the Exchange about Audio recording of earning conference call held on 04.11.2026 on un-audited financial results for the quarter ended 30.09