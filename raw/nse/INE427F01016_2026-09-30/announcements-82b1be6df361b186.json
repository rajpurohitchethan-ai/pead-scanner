[{"an_dt": "12-Nov-2026 18:44:53", "attFileSize": "691.39 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/CHALET_12112026184045_Transcript05112026.pdf", "attchmntText": "Chalet Hotels Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:00", "dt": "12112026184453", "exchdisstime": "12-Nov-2026 18:44:53", "fileSize": "691.39 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106857337", "smIndustry": null, "sm_isin": "INE427F01016", "sm_name": "Chalet Hotels Limited", "sort_date": "2026-11-12 18:44:53", "symbol": "CHALET", "voiceSummary": "Chalet Hotels Limited filed the transcript of its Q2 FY27 earnings call with the NSE and BSE. The call covered financial results for the quarter and six months ended September 30, 2026. Core business revenue grew 11% year-on-year to INR 5,110 million. EBITDA increased 13% to INR 2,274 million. EBITDA margin improved by 110 basis points to 45%. Net profit after tax was INR 2,163 million. For the half year, revenue rose 10% to INR 10,250 million. EBITDA grew 14% to INR 4,674 million. Net profit after tax stood at INR 3,024 million. The company exercised the concessional tax regime under Section 206 of the Income Tax Act, 2025. This resulted in a tax credit of INR 1,125 million. The company rebranded its Navi Mumbai property to ATHIVA Pulse. Construction at CIGNUS 2 Powai and Taj at Delhi International Airport is on schedule. The total pipeline stands at 2,036 keys.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/CHALET_12112026184045_Transcript05112026.mp3"}, {"an_dt": "09-Nov-2026 23:45:59", "attFileSize": "415.51 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/CHALET_09112026234526_Regulation30InvestorConferenceIntimation09112026.pdf", "attchmntText": "Chalet Hotels Limited has informed the Exchange about Schedule of meet", "bflag": null, "csvName": null, "de