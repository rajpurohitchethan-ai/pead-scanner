[{"an_dt": "17-Nov-2026 15:17:14", "attFileSize": "2.96 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/STLNETWORKS_17112026151636_BSENSE.pdf", "attchmntText": "STL Networks Limited has informed the Exchange about Credit Rating- Revision", "bflag": null, "csvName": null, "desc": "Credit Rating- Revision", "difference": "00:00:01", "dt": "17112026151714", "exchdisstime": "17-Nov-2026 15:17:15", "fileSize": "2.96 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106863639", "smIndustry": null, "sm_isin": "INE1VXE01018", "sm_name": "STL Networks Limited", "sort_date": "2026-11-17 15:17:14", "symbol": "STLNETWORK", "voiceSummary": "STL Networks Limited intimates the revision in credit ratings for its Non-convertible debentures and Bank Loan Facilities. India Ratings and Research Private Limited downgraded the ratings in its Press Release dated November 16, 2026. The previous rating for Non-convertible debentures was IND A-/Stable. The current rating is IND BBB+/Stable. The reason for the downgrade is weaker than expected performance. The previous rating for Bank loan facilities was IND A-/Stable and IND A2+. The current long-term rating is IND BBB+/Stable. The short-term rating remains IND A2+. This disclosure is made under Regulation 30 and 51 of the SEBI Listing Obligations and Disclosure Requirements Regulations, 2015. The information is also available on the company website at www.inveniatech.com.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/STLNETWORKS_17112026151636_BSENSE.mp3"}, {"an_dt": "13-Nov-2026 13:07:57", "attFileSize": "481.53 KB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/STLNETWORKS_13112026130650_BSENSEAllotment.pdf", "attchmntText": "STL Networks Limited has informed the Exchange regarding allotment of 84790 securities pursuant to ESOP/ESPS at its meeting held on November 13, 2026", "bflag": null, "csvName": null, "desc": "Allotment of Securities", "difference": "00:00:01", "dt": "13112026130