[{"an_dt": "11-Nov-2026 11:07:56", "attFileSize": "833.20 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SHILPAMED_11112026110705_Disclosure.pdf", "attchmntText": "Shilpa Medicare Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "11112026110756", "exchdisstime": "11-Nov-2026 11:07:57", "fileSize": "833.20 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106854763", "smIndustry": "Pharmaceuticals", "sm_isin": "INE790G01023", "sm_name": "Shilpa Medicare Limited", "sort_date": "2026-11-11 11:07:56", "symbol": "SHILPAMED", "voiceSummary": "Shilpa Medicare Limited filed the transcript of its Q2 FY27 conference call held on 05 November 2026. The company reported record quarterly revenue of INR538 crores, up 35% year-on-year, and half-year revenue of INR1,007 crores, up 44%. Quarterly EBITDA reached INR151 crores, up 37%, with a margin of 28%. Half-year EBITDA was INR290 crores, up 40%, with a margin of 29%. Profit after tax was INR79 crores for the quarter and INR180 crores for the half-year. Net debt stands at INR612 crores. Return on capital employed improved to 13.3%. Management highlighted growth in API, formulation, and biologics segments. The company is commissioning large peptide manufacturing capacity by the end of FY27. Semaglutide exhibit batches were completed for European and Rest of World markets. Unicycive Therapeutics received a revised PDUFA date of March 2027.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SHILPAMED_11112026110705_Disclosure.mp3"}, {"an_dt": "05-Nov-2026 21:01:36", "attFileSize": "574.01 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SHILPAMED_05112026205950_Disclosure.pdf", "attchmntText": "Shilpa Medicare Limited has informed the Exchange about Link of Recording", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con