 Pvt. Limited (Ramdev) and Tonira Exports Limited (Tonira) , Company's wholly owned subsidiary companies (���Transferor Companies���), with the Company under Sections 230 to 232 of the Companies Act, 2013. Therefore the financial statements of Ramdev and Tonira have been merged with the Company w.e.f. the Appointed Date of April 1, 2022. The comparative quarters presented in these financial results have also been restated for merger effect.      5 The Company has only one operating segment viz. 'Pharmaceuticals'.   6 Figures for the previous period have been regrouped to conform to the figures of the current period.", "re_desc_note_seg": "-", "re_dil_eps_bfr_exi": null, "re_dilut_eps_for_cont_dic_opr": "5.4", "re_diluted_eps": null, "re_excepn_items": null, "re_excepn_items_new": "0", "re_extraord_items": null, "re_face_val": "1", "re_face_value_debt": null, "re_from_dt": "01-OCT-2023", "re_goi_per_shhd": null, "re_grs_npa": null, "re_grs_npa_per": null, "re_inc_dre_sttr": "-111", "re_income_inv": null, "re_int_dis_adv_bills": null, "re_int_earned": null, "re_int_expd": null, "re_int_new": "2721", "re_int_ser_cov": null, "re_minority_int": null, "re_net_profit": "13694", "re_net_sale": "150683", "re_notes_to_ac": "", "re_oper_exp": null, "re_oper_exp_bef_pro_cont": null, "re_oth": null, "re_oth_exp": "41362", "re_oth_inc": null, "re_oth_inc_new": "1689", "re_oth_oper_exp": null, "re_oth_pro_cont": null, "re_oth_tot_exp": "132357", "re_paid_debt": null, "re_pdup": "2537", "re_per_grs_npa": null, "re_pro_aft_int_bef_excep": null, "re_pro_los_frm_dis_opr": "0", "re_pro_loss_bef_tax": "20015", "re_pro_loss_bef_tax_sum": null, "re_prolos_dis_opr_aftr_tax": "0", "re_proloss_ord_act": "13694", "re_prov_emp_pay": null, "re_pur_trd_goods": "7525", "re_rawmat_consump": "41125", "re_remarks": null, "re_res_reval": null, "re_res_type": "U", "re_ret_asset": null, "re_seg_remarks": null, "re_seq_num": "1168204", "re_share_associate": "0", "re_staff_cost": "33433", "re_tax": "6321