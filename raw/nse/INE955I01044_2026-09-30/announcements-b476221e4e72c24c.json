[{"an_dt": "07-Nov-2026 17:25:37", "attFileSize": "725.17 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SEJALLTD_07112026172513_Press_Release_signed.pdf", "attchmntText": "Sejal Glass Limited has informed the Exchange regarding a press release dated November 07, 2026, titled \"Press Release 'Sejal Glass Limited Proposes Rs. 40.80 Crore Acquisition of Architectural and Automotive Glass Business.'\".", "bflag": null, "csvName": null, "desc": "Press Release", "difference": "00:00:01", "dt": "07112026172537", "exchdisstime": "07-Nov-2026 17:25:38", "fileSize": "725.17 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106852626", "smIndustry": null, "sm_isin": "INE955I01044", "sm_name": "Sejal Glass Limited", "sort_date": "2026-11-07 17:25:37", "symbol": "SEJALLTD", "voiceSummary": "Sejal Glass Limited has proposed the acquisition of Magnumtuff India Private Limited's Architectural and Automotive Glass business undertaking for Rs. 40.80 crore. The Board of Directors approved the execution of a Business Transfer Agreement for this slump sale. The transaction includes associated factory land and building. The target business reported operating revenue of Rs. 36.20 crore during FY26. This acquisition expands Sejal Glass's manufacturing network to four facilities in India. The new facility is located in Karnataka. The transaction is expected to complete on or before 30th November 2026. This is subject to the completion of required transaction formalities.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SEJALLTD_07112026172513_Press_Release_signed.mp3"}, {"an_dt": "06-Nov-2026 14:11:04", "attFileSize": "658.30 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SEJALLTD_06112026141017_Outcome.pdf", "attchmntText": "Sejal Glass Limited has informed the Exchange regarding the proposed execution of Business Transfer Agreement with M/s. Magnumtuff India Private Limited", "bflag": null, "csvName": null, "desc": "Outcome of Bo