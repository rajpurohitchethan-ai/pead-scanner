[{"an_dt": "11-Nov-2026 17:13:56", "attFileSize": "287.53 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SANDUR_11112026171321_Ltr2SEs_Grant_of_EC.pdf", "attchmntText": "Sandur Manganese & Iron Ores Limited has informed the Exchange regarding 'Grant of Environmental Clearance by Ministry of Environment, Forest and Climate Change'.", "bflag": null, "csvName": null, "desc": "Updates", "difference": "00:00:01", "dt": "11112026171356", "exchdisstime": "11-Nov-2026 17:13:57", "fileSize": "287.53 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106855360", "smIndustry": null, "sm_isin": "INE149K01016", "sm_name": "Sandur Manganese & Iron Ores Limited", "sort_date": "2026-11-11 17:13:56", "symbol": "SANDUMA", "voiceSummary": "The Sandur Manganese and Iron Ores Limited has received Environmental Clearance from the Ministry of Environment, Forest and Climate Change. The clearance, identified by number EC26A0000KA5280635N dated 11 November 2026, permits the enhancement of iron ore Run of Mine capacity from 7.85 Million Tonnes Per Annum to 9.42 Million Tonnes Per Annum. It also allows for the reduction of manganese ore Run of Mine capacity from 1.34 Million Tonnes Per Annum to 0.7330 Million Tonnes Per Annum. The approval is based on the Indian Bureau of Mines approved mining plan for Mining Lease No.2678 within an area of 1860.10 hectares. The Beneficiation plant configuration will change from 1 x 7.00 to 2 x 3.5 Million Tonnes Per Annum. The Downhill Conveyor System remains unchanged. The company will initiate further regulatory approvals to operate at these enhanced levels.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SANDUR_11112026171321_Ltr2SEs_Grant_of_EC.mp3"}, {"an_dt": "11-Nov-2026 16:28:28", "attFileSize": "354.21 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SANDUR_11112026162744_Ltr2SEsCessationofGPK.pdf", "attchmntText": "Sandur Manganese & Iron Ores Limited has informed the Exchange regarding completion of term of G. P. Kundargi as an Independent Director w.e.f. November 11, 2026.", "bflag": null, "csvName": null, "desc": "Cessation", "difference": "00:00:00", "dt": "11112026162828", "exchdisstime": "11-Nov-2026 16:28:28", "fileSize": "354.21 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106855245", "smIndustry": null, "sm_isin": "INE149K01016", "sm_name": "Sandur Manganese & Iron Ores Limited", "sort_date": "2026-11-11 16:28:28", "symbol": "SANDUMA", "voiceSummary": "The Sandur Manganese and Iron Ores Limited announces that G. P. Kundargi, DIN 02256516, is completing his second consecutive term as an Independent Director on 11 November 2026. He will cease to be an Independent Director on this date. The Board has appointed him as a Non-Executive Director with effect from 12 November 2026. This appointment is liable to retire by rotation and is subject to shareholders’ approval. G. P. Kundargi was previously re-appointed as an Independent Director for a second term of five consecutive years commencing from 12 November 2021 till 11 November 2026, pursuant to a resolution passed by shareholders at the 67th Annual General Meeting held on 22 September 2021.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SANDUR_11112026162744_Ltr2SEsCessationofGPK.mp3"}, {"an_dt": "06-Nov-2026 17:53:22", "attFileSize": "3.76 MB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SANDUR_06112026175039_Ltr2SEsNewspaperAd_signed.pdf", "attchmntText": "Sandur Manganese & Iron Ores Limited has informed the Exchange about Copy of Newspaper Publication regarding Postal Ballot Notice", "bflag": null, "csvName": null, "desc": "Copy of Newspaper Publication", "difference": "00:00:00", "dt": "06112026175322", "exchdisstime": "06-Nov-2026 17:53:22", "fileSize": "3.76 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106851114", "smIndustry": null, "sm_isin": "INE149K01016", "sm_name": "Sandur Manganese & Iron Ores Limited", "sort_date": "20