[{"an_dt": "20-Nov-2026 18:49:33", "attFileSize": "982.36 KB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/SINGERINDIA_20112026184910_Intimation_of_Transcript.pdf", "attchmntText": "Singer India Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "20112026184933", "exchdisstime": "20-Nov-2026 18:49:34", "fileSize": "982.36 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106867766", "smIndustry": null, "sm_isin": "INE638A01035", "sm_name": "Singer India Limited", "sort_date": "2026-11-20 18:49:33", "symbol": "SINGERIND", "voiceSummary": "Singer India Limited filed the transcript of its Investor Conference Call for the quarter and half year ended September 30, 2026, with the BSE and NSE. The call was held on November 16, 2026. Management reported Q2 revenue growth of 34% to Rs. 185.2 crores. Profit before tax increased by 79% to Rs. 9.4 crores. EBITDA grew by 85% to Rs. 10.9 crores. The company sustained strong momentum in sewing machines and appliances. A new factory in Bhiwadi is progressing with pilot production planned next month. Credit ratings were enhanced to BBB/Stable for long term and A3+ for short term. Trade receivables increased due to higher revenue and liberal credit terms in e-commerce. Government orders are largely complete with negligible residual tail end. Industrial sewing machine revenue share is approximately 10 to 12 percent.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SINGERINDIA_20112026184910_Intimation_of_Transcript.mp3"}, {"an_dt": "19-Nov-2026 15:34:53", "attFileSize": "1.98 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/SINGERINDIA_19112026153420_20261119152332560.pdf", "attchmntText": "Singer India Limited has informed the Exchange about General Updates", "bflag": null, "csvName": null, "desc": "General Updates", "difference": "00:00:01", "dt": "19112026153453", "exchdisstime": "19-Nov-2026 15:34:54", "fileSize": "1.98 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106866179", "smIndustry": null, "sm_isin": "INE638A01035", "sm_name": "Singer India Limited", "sort_date": "2026-11-19 15:34:53", "symbol": "SINGERIND", "voiceSummary": "Singer India Limited has obtained Consent to Operate from the Rajasthan State Pollution Control Board for its manufacturing facility in Bhiwadi, Rajasthan. The consent was received on 19th November 2026 and is valid until 30th September 2031. This approval enables the company to undertake manufacturing operations at the facility located at E-1229, RIICO Industrial Area, Ghatal, Bhiwadi, District Khairthal-Tijara, Rajasthan, subject to stipulated terms and conditions. The company has made an investment of Rs. 923 Lacs towards land, building, plant and machinery, and miscellaneous assets at this facility. The disclosure is made pursuant to Regulation 30 of the SEBI LODR Regulations.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SINGERINDIA_19112026153420_20261119152332560.mp3"}, {"an_dt": "13-Nov-2026 12:23:55", "attFileSize": "2.79 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/SINGERINDIA_13112026122218_Newspaper_intimation.pdf", "attchmntText": "Singer India Limited has informed the Exchange about Copy of Newspaper Publication", "bflag": null, "csvName": null, "desc": "Copy of Newspaper Publication", "difference": "00:00:01", "dt": "13112026122355", "exchdisstime": "13-Nov-2026 12:23:56", "fileSize": "2.79 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106858312", "smIndustry": null, "sm_isin": "INE638A01035", "sm_name": "Singer India Limited", "sort_date": "2026-11-13 12:23:55", "symbol": "SINGERIND", "voiceSummary": null, "voiceUrl": null}, {"an_dt": "12-Nov-2026 18:56:16", "attFileSize": "3.54 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/SINGERINDIA_12112026185541_Investor_Presentation_Q2_FY_26-2