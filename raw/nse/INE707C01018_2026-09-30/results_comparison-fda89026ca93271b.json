_funds": null, "re_basic_eps": null, "re_basic_eps_for_cont_dic_opr": "0.56", "re_bsc_eps_bfr_exi": null, "re_cap_ade_rat": null, "re_cet_1_ret": null, "re_con_pro_loss": "91.15", "re_create_dt": "14-SEP-2020", "re_curr_tax": "0", "re_debt_eqt_rat": "0.02", "re_debt_rdmption": null, "re_debt_ser_cov": "0.02", "re_deff_tax": "30.43", "re_depr_und_exp": "18.69", "re_desc_note_fin": "Notes:tttttttt    n1. The business activity of the Company falls within a single segment viz ���financing activities and hence there is no other reportable segment as per Ind AS 108.tttttttt    n2. The Noval Corona virus (COVID-19) pandemic (declared as such by the World Health Organisation on March 11, 2020) has contributed to significant decline and volatility in global and Indian market and significant decrease in economic activity. On March 24, 2020, the Indian government announced lockdown till April 14, 2020, which was further extended till May 31, 2020 through the subsequent announcements, to contain the spread of virus. This has led to significant disruptions and disclosures for individuals and business, impacting Company's regular operations including lending and collection activities. The Company's client base and AUM is from the semi-urban/rural segment, where the impact of COVID-19 has been relatively lower. A large segment of our customers are linked to the local economy & operation in essential services and the government has announced a series of economic relief measures for MSME sector, which is expected to support borrower's repayment capacity. From June 1, 2020 onwards, further relaxation in lock down has been granted across the Country, which has helped the Company employees to contract the borrowers.tttttttt    n Further, pursuant to Reserve Bank of India circular dated March 31, 2020 and May 23, 2020 allowing lending institution to offer moratorium to borrowers on payment of instalment falling due between March 1, 2020 and August 31, 2020, the Company gave the option of availing moratorium to all its borrowers from March 1, 2020 for three months.    nIn management's view, providing moratorium to borrower at a large scale based on RBI directives, by itself is considered to result in a significant increase in credit risk for such borrowers. Accordingly, considering the unique impact and widespread impact of COVID-19 pandemic, the company has estimated expected credit loss allowance over and above normal provision amounting to Rs. 64.31 lakhs (previous quarter and year ended Rs. 266.27 lakhs) [in case of consolidated Rs. 64.47 lakhs (previous quarter and year ended Rs. 268.89 lakhs)], based on information available at that point in time to reflect, among other things, the deterioration in the macro-economic factors. The Company estimates to recover the carrying amount of all its assets including investments, receivables and loans in the ordinary course of business based on information available on current economic conditions. The Company has adequate liquidity to discharge its obligations. These estimates are subject to uncertainty and may be affected by the severity and duration of the pandemic. Given the dynamic nature of pandemic situation, these estimates are based on early indicators, subject to uncertainty and may be affected by the severity and duration of pandemic, including government and regulatory measures on the business and financial metrics of the Company. tttttttt    n3 Figures for the quarter ended March 31,2020 are the balancing figure between the audited figures for the financial year ended March 31, 2020 and unaudited published year to date figures upto December 31, 2019.tttttttt    n4. The previous year/period have been grouped/ rearranged to make figures comparable with current year/period figures. tttttttt    n5. The company has decided to voluntary liquidate the wholy owned subsidiary company Capital Trust Housing Pvt. Ltd, which was incorporated to do the housing finance business due to current situations.tttttttt    n6. The above results were reviewed by the Audit Committee and approved by  the Board of Directors of the Company at their meeting  held on 14th September, 2020.  The Statutory Auditors have carried out a limited review of the above financial results.", "re_desc_note_seg": "-", "re_dil_eps_bfr_exi": null, "re_dilut_eps_for_cont_dic_opr": "0.56", "re_diluted_eps": null, "re_excepn_items": null, "re_excepn_items_new": "0", "re_extraord_items": null, "re_face_val": "10", "re_face_value_debt": null, "re_from_dt": "01-APR-2020", "re_goi_per_shhd": null, "re_grs_npa": null, "re_grs_npa_per": null, "re_inc_dre_sttr": "0", "re_income_inv": null, "re_int_dis_adv_bills": null, "re_int_earned": null, "re_int_expd": null, "re_int_new": "995.95", "re_int_ser_cov": "0.01", "re_minority_int": null, "re_net_profit": "91.15", "re_net_sale": "2566.81", "re_notes_to_ac": "", "re_oper_exp": null, "re_oper_exp_bef_pro_cont": null, "re_oth": null, "re_oth_exp": "196.11", "re_oth_inc": null, "re_oth_inc_new": "92.81", "re_oth_oper_exp": null, "re_oth_pro_cont": null, "re_oth_tot_exp": "2538.04", "re_paid_debt": null, "re_pdup": "1621.75", "re_per_grs_npa": null, "re_pro_aft_int_bef_excep": null, "re_pro_los_frm_dis_opr": "0", "re_pro_loss_bef_tax": "121.58", "re_pro_loss_bef_tax_sum": null, "re_prolos_dis_opr_aftr_tax": "0", "re_proloss_ord_act": "91.15", "re_prov_emp_pay": null, "re_pur_trd_goods": "0", "re_rawmat_consump": "0", "re_remarks": null, "re_res_reval": null, "re_res_type": "U", "re_ret_asset": null, "re_seg_remarks": null, "re_seq_num": "1091684", "re_share_associate": "0", "re_staff_cost": "765.23", "re_tax": "30.43", "re_tax_expens_of_dis_opr": "0", "re_to_dt": "30-JUN-2020", "re_tot_exp_exc_pro_cont": null, "re_tot_inc": null, "re_total_inc": "2659.62"}, {"re_amt_grs_np_asst": null, "re_bal_rbi_oth_bnk_funds": null, "re_basic_eps": null, "re_basic_eps_for_cont_dic_opr": "6.67", "re_bsc_eps_bfr_exi": null, "re_cap_ade_rat": null, "re_cet_1_ret": null, "re_con_pro_l