[{"an_dt": "20-Nov-2026 11:45:59", "attFilePath": null, "attFileSize": "706.21 KB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/CSCOMPLIANCE_20112026114033_TVS_SCS_EC_Transcript_Q2_Disclosure_sd.pdf", "attchmntText": "TVS Supply Chain Solutions Limited has informed the Exchange about Earnings Call Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "20112026114559", "exchdisstime": "20-Nov-2026 11:46:00", "fileSize": "706.21 KB", "hasXbrl": true, "nasUploadFlag": null, "objUploadFlag": null, "old_new": null, "orgid": null, "seq_id": "106867140", "smIndustry": null, "sm_isin": "INE395N01027", "sm_name": "TVS Supply Chain Solutions Limited", "sort_date": "2026-11-20 11:45:59", "symbol": "TVSSCS", "voiceSummary": "TVS Supply Chain Solutions filed the transcript of its earnings call held on November 16, 2026, regarding financial results for the quarter and half year ended September 30, 2026. The company reported highest ever quarterly revenue of Rs. 3,687 crores, a year-on-year growth of 38%. Profit before tax doubled to Rs. 50.6 crores from Rs. 24.4 crores in Q2 FY26. Integrated Supply Chain Solutions revenue grew by 25% year-on-year, while Global Forwarding Solutions revenue grew by 79.1% year-on-year. India geography revenue recorded 64.1% year-on-year growth. New business revenue crossed Rs. 500 crores for the third consecutive quarter. The company signed a strategic MOU with Sankyu Inc., which intends to acquire 0.5% equity in TVS SCS, subject to regulatory approvals. A joint venture with ALA MENA has been formed for aerospace and defense sectors. Gross debt increased by Rs. 140 crore to fund working capital for volume growth in the GFS segment.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/CSCOMPLIANCE_20112026114033_TVS_SCS_EC_Transcript_Q2_Disclosure_sd.mp3"}, {"an_dt": "17-Nov-2026 17:21:40", "attFilePath": null, "attFileSize": "429.86 KB", "attc