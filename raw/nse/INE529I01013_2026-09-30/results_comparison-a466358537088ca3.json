eemable in 5 equal installments of Rs. 600 lakhs each at the end of 16th, 17th, 18th, 19th and 20th year from the allotment date. During the quarter, the Company has redeemed these preference shares along with pro-rata dividend after obtaining the approval of all stakeholders.", "re_desc_note_seg": "-", "re_dil_eps_bfr_exi": null, "re_dilut_eps_for_cont_dic_opr": "4.83", "re_diluted_eps": null, "re_excepn_items": null, "re_excepn_items_new": "0", "re_extraord_items": null, "re_face_val": "1", "re_face_value_debt": null, "re_from_dt": "01-OCT-2023", "re_goi_per_shhd": null, "re_grs_npa": null, "re_grs_npa_per": null, "re_inc_dre_sttr": "154.27", "re_income_inv": null, "re_int_dis_adv_bills": null, "re_int_earned": null, "re_int_expd": null, "re_int_new": "1126.34", "re_int_ser_cov": null, "re_minority_int": null, "re_net_profit": "4215.26", "re_net_sale": "30146.84", "re_notes_to_ac": "", "re_oper_exp": null, "re_oper_exp_bef_pro_cont": null, "re_oth": null, "re_oth_exp": "10475.57", "re_oth_inc": null, "re_oth_inc_new": "72.06", "re_oth_oper_exp": null, "re_oth_pro_cont": null, "re_oth_tot_exp": "24570.55", "re_paid_debt": null, "re_pdup": "872.64", "re_per_grs_npa": null, "re_pro_aft_int_bef_excep": null, "re_pro_los_frm_dis_opr": "0", "re_pro_loss_bef_tax": "5648.35", "re_pro_loss_bef_tax_sum": null, "re_prolos_dis_opr_aftr_tax": "0", "re_proloss_ord_act": "4215.26", "re_prov_emp_pay": null, "re_pur_trd_goods": "1.44", "re_rawmat_consump": "9525.35", "re_remarks": null, "re_res_reval": null, "re_res_type": "U", "re_ret_asset": null, "re_seg_remarks": null, "re_seq_num": "1163994", "re_share_associate": "0", "re_staff_cost": "2053.02", "re_tax": "1433.09", "re_tax_expens_of_dis_opr": "0", "re_to_dt": "31-DEC-2023", "re_tot_exp_exc_pro_cont": null, "re_tot_inc": null, "re_total_inc": "30218.9"}]}