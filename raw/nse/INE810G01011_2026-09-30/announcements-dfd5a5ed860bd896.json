[{"an_dt": "09-Nov-2026 08:57:31", "attFileSize": "1.15 MB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SHYAMMETL_09112026085719_SMELPressRelease09112026.pdf", "attchmntText": "Shyam Metalics And Energy Limited has informed the Exchange regarding a press release dated November 09, 2026, titled \"Shyam Metalics Reaffirms Credit Ratings of  CRISIL AA+/Stable  and  CRISIL A1+ ; Bank Debt Ratings Enhanced to &#8377;4,500 Crore.\".", "bflag": null, "csvName": null, "desc": "Press Release", "difference": "00:00:01", "dt": "09112026085731", "exchdisstime": "09-Nov-2026 08:57:32", "fileSize": "1.15 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106852993", "smIndustry": null, "sm_isin": "INE810G01011", "sm_name": "Shyam Metalics and Energy Limited", "sort_date": "2026-11-09 08:57:31", "symbol": "SHYAMMETL", "voiceSummary": "Shyam Metalics and Energy Limited announced that CRISIL Ratings Limited has reaffirmed its long-term credit rating at CRISIL AA plus with a stable outlook and its short-term rating at CRISIL A1 plus. The agency has enhanced the rated bank debt amount to 4500 crore rupees, up from 3600 crore rupees. Additionally, the rating for the company's 50 crore rupee commercial paper programme was reaffirmed at CRISIL A1 plus. The announcement was issued on 09th November 2026.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SHYAMMETL_09112026085719_SMELPressRelease09112026.mp3"}, {"an_dt": "07-Nov-2026 15:01:04", "attFileSize": "954.21 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SHYAMMETL_07112026150041_SMELTranscriptofConcal07112026.pdf", "attchmntText": "Shyam Metalics And Energy Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "07112026150104", "exchdisstime": "07-Nov-2026 15:01:05", "fileSize": "954.21 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106852407", "smIndustry": null, "sm_isin": "INE810G01011", "sm_name": "Shyam Metalics and Energy Limited", "sort_date": "2026-11-07 15:01:04", "symbol": "SHYAMMETL", "voiceSummary": "Shyam Metalics and Energy Limited filed the transcript of the conference call for Unaudited Financial Results for the Second Quarter and Half Year Ended 30th September, 2026. The call was held on Monday, 02nd November, 2026. For Q2 FY27, revenue grew 33.4% year-on-year to INR5,960 crores. EBITDA increased 40.9% year-on-year to INR857 crores. Profit after tax rose 96.2% year-on-year to INR511 crores. For H1 FY27, revenue stood at INR11,415 crores. EBITDA was INR1,670 crores. Profit after tax was INR862 crores. The company proposed acquiring a 51% controlling stake in Alom Solar Private Limited. The estimated capex for this project is INR360 crores. The company's share is close to INR185 crores.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SHYAMMETL_07112026150041_SMELTranscriptofConcal07112026.mp3"}, {"an_dt": "06-Nov-2026 15:31:20", "attFileSize": "1.44 MB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SHYAMMETL_06112026153110_SalesRelease06112026.pdf", "attchmntText": "Shyam Metalics And Energy Limited has informed the Exchange regarding Monthly Business Updates for the month of October 2026", "bflag": null, "csvName": null, "desc": "Monthly Business Updates", "difference": "00:00:00", "dt": "06112026153120", "exchdisstime": "06-Nov-2026 15:31:20", "fileSize": "1.44 MB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106850425", "smIndustry": null, "sm_isin": "INE810G01011", "sm_name": "Shyam Metalics and Energy Limited", "sort_date": "2026-11-06 15:31:20", "symbol": "SHYAMMETL", "voiceSummary": null, "voiceUrl": null}, {"an_dt": "06-Nov-2026 12:38:21", "attFileSize": "829.59 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SHYAMMETL_06112026123809_SMELCreditratingintimation06112026.pdf", "attchmntText": "Shyam Metalics And Energy