[{"an_dt": "12-Nov-2026 11:13:33", "attFileSize": "444.40 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SAILIFE_12112026111218_Stx_Intimation_ECT_06112026_Signed.pdf", "attchmntText": "Sai Life Sciences Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "12112026111333", "exchdisstime": "12-Nov-2026 11:13:34", "fileSize": "444.40 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106856184", "smIndustry": null, "sm_isin": "INE570L01029", "sm_name": "Sai Life Sciences Limited", "sort_date": "2026-11-12 11:13:33", "symbol": "SAILIFE", "voiceSummary": "Sai Life Sciences Limited filed the transcript of its Q2 FY27 earnings conference call held on 06th November 2026. The company reported a 23% year-on-year revenue growth for the quarter, with CDMO business growing 20% and CRO business growing 28%. First-half revenue growth stood at 17% year-on-year. EBITDA margins remained at 28% for both the quarter and the half-year. The company incurred approximately INR621 crores in capex during the first six months of fiscal 2027. Expanded small molecule manufacturing capacity at Bidar is ready for commercial batches. Commissioning of additional 225 KL capacity is now expected by early Q3 of fiscal 2028. Design work for a new manufacturing site in Telangana has commenced, with ground breaking expected in Q4 of fiscal 2027. The transcript is available on the company website.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/SAILIFE_12112026111218_Stx_Intimation_ECT_06112026_Signed.mp3"}, {"an_dt": "12-Nov-2026 11:08:29", "attFileSize": "596.67 KB", "attchmntFile": "https://nsearchives.nseindia.com/corporate/SAILIFE_12112026110819_Stx_Monitoring_Agency_061120_Signed.pdf", "attchmntText": "Sai Life Sciences Limited has informed the Exchange about General Updates", "bflag": null, "csvName": null, "desc": "Monitoring A