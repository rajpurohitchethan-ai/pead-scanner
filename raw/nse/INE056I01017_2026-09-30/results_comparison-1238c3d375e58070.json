o  its wholly owned subsidiary company  M/s Refex Green Mobility Limited  to the tune of Rs. 15.03 crores. This guarantee has been extended against the vehicle loans taken for the Electric Vehicles.   7. The Board of Directors of the Company at its meeting held on January 24, 2024 approved the Sub-division/ split of each equity share of face value of Rs. 10/- (Rupees Ten only) each, fully paid-up into 5 (Five) equity shares of face value of Rs. 2 /- (Rupees Two only) each, fully paid-up by alteration of Capital Clause of the Memorandum of Association of the Company, subject to the approval of the members of the Company.   8. During the current quarter an exceptional item amounting to Rs. 1.47 lakhs has been debited to the P&L account towards diminution in value of investments.     9. Figures have been re-grouped/re-classified to make them comparable to the figures wherever necessary.   10. Figures in brackets are representing the negative values.", "re_desc_note_seg": "-", "re_dil_eps_bfr_exi": null, "re_dilut_eps_for_cont_dic_opr": "8.92", "re_diluted_eps": null, "re_excepn_items": null, "re_excepn_items_new": "-1.47", "re_extraord_items": null, "re_face_val": "10", "re_face_value_debt": null, "re_from_dt": "01-OCT-2023", "re_goi_per_shhd": null, "re_grs_npa": null, "re_grs_npa_per": null, "re_inc_dre_sttr": "-155.41", "re_income_inv": null, "re_int_dis_adv_bills": null, "re_int_earned": null, "re_int_expd": null, "re_int_new": "728.71", "re_int_ser_cov": null, "re_minority_int": null, "re_net_profit": "1977.67", "re_net_sale": "30150.59", "re_notes_to_ac": "", "re_oper_exp": null, "re_oper_exp_bef_pro_cont": null, "re_oth": null, "re_oth_exp": "504.55", "re_oth_inc": null, "re_oth_inc_new": "321.77", "re_oth_oper_exp": null, "re_oth_pro_cont": null, "re_oth_tot_exp": "27736.47", "re_paid_debt": null, "re_pdup": "2213.35", "re_per_grs_npa": null, "re_pro_aft_int_bef_excep": null, "re_pro_los_frm_dis_opr": "0", "re_pro_loss_bef_tax": "2734.42", "re_pro_loss_bef_tax_