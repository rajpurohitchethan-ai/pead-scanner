[{"an_dt": "13-Nov-2026 21:03:39", "attFileSize": "861.36 KB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/HINDOILEXPCS_13112026210152_EC_Transcript.pdf", "attchmntText": "Hindustan Oil Exploration Company Limited has informed the Exchange about Transcript", "bflag": null, "csvName": null, "desc": "Analysts/Institutional Investor Meet/Con. Call Updates", "difference": "00:00:01", "dt": "13112026210339", "exchdisstime": "13-Nov-2026 21:03:40", "fileSize": "861.36 KB", "hasXbrl": true, "old_new": null, "orgid": null, "seq_id": "106859907", "smIndustry": "Oil Exploration/Production", "sm_isin": "INE345A01011", "sm_name": "Hindustan Oil Exploration Company Limited", "sort_date": "2026-11-13 21:03:39", "symbol": "HINDOILEXP", "voiceSummary": "Hindustan Oil Exploration Company Limited filed the transcript of its Q2 FY2026-27 earnings call with the National Stock Exchange and BSE Limited. The call was held on November 6, 2026. The company reported that all assets except B-80 operated at full capacity during the half-year. Management discussed plans for workovers on wells D1 and D2 at the B-80 field, aiming to resume production by late December or early January. Three new wells are planned for B-80 following workovers. In the Cauvery Basin, the PY-1 field requires intervention to restore gas production, with potential output estimated at 15 million to 20 million standard cubic feet per day. Drilling at PY-1 is contingent on securing firm take-or-pay agreements. At the Dirok field in Assam, current production averages 0.7 million standard cubic meters daily, with potential to reach 1.2 million cubic meters once pipeline bottlenecks are resolved. Additional wells are approved pending evacuation infrastructure upgrades.", "voiceUrl": "https://nsearchives.nseindia.in/ann_voice/HINDOILEXPCS_13112026210152_EC_Transcript.mp3"}, {"an_dt": "07-Nov-2026 20:58:28", "attFileSize": "10.58 MB", "attchmntFile": "https://nsearchives.nseindia.in/corporate/HINDOILEXPCS_0711202